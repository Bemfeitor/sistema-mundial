# Copie para .env.local e preencha. Sem as variáveis do Supabase o sistema roda em MODO DEMO
# (banco em memória com dados fictícios, que somem ao reiniciar o servidor).

# --- Supabase (Project Settings → API) ---
# URL do projeto, ex.: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública "anon" (usada só para login com Supabase Auth no navegador/servidor)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role" — SECRETA, só no servidor. Todas as gravações passam por ela (ignora RLS).
# Nunca exponha em código cliente nem use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA do balcão (ajuda ao vendedor) ---
# Chave da API da Anthropic (Claude). Opcional: sem ela o balcão usa regras locais.
ANTHROPIC_API_KEY=
# Modelo usado no balcão (ex.: claude-sonnet-4-5). Opcional.
BALCAO_AI_MODEL=

# --- Alternativa: provedor compatível com a API da OpenAI (OpenRouter, Ollama, LM Studio etc.) ---
# Ex.: https://openrouter.ai/api/v1 ou http://localhost:11434/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Aplicação ---
# URL pública do sistema (usada nas instruções de conexão do agente MCP), ex.: https://sistema.oticamundial.com.br
APP_URL=http://localhost:3000

# --- Servidor MCP via stdio (scripts/mcp-stdio.ts) ---
# Token gerado em /admin/agente. Normalmente definido na config do cliente MCP, não aqui.
# OTICA_AGENT_TOKEN=
